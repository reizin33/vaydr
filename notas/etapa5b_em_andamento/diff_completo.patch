+		z.ferir(dano, global_position, 0, {"k": "bala", "head": reg == "cabeca", "reg": reg, "arma": id, "mult": Armas.mult_regiao(cat, reg),
+			"forte": true, "empurra": 0.7 if id == "rifle" else 0.45})
+		main.ui.acerto(reg == "cabeca")
+		ign.append(z)
