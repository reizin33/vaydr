+		if not h.has("z"):
+			if h.has("p"):
+				main.efeitos.faiscas(h["p"])
+				fim = h["p"]
+			break
+		var z = h["z"]
+		var hp: Vector3 = h["p"]
+		var reg := Armas.regiao(z, hp)
+		var dano := Armas.dano_tiro(id, reg, cam.global_position.distance_to(hp), q) * (float(B.get("atravessa_k", 1.0)) if n > 0 else 1.0)
+		main.efeitos.sangue(hp, -dir)
