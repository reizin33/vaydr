+## o molotov, a bomba caseira e a isca: o braço vai para trás e joga (até 26 m, para onde a mira aponta)
+func _arremesso(id: String) -> void:
+	acao = {"tipo": "arremesso", "t": 0.0, "dur": 0.62, "feito": false, "id": id}
+	acao_n += 1
+	cd = 0.7
